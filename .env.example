# Copie este arquivo para ".env" (na raiz do projeto) e preencha com os
# dados do SEU MySQL. O arquivo .env não vai para o GitHub.
MYSQL_HOST=localhost
MYSQL_PORT=3306
# No seu computador pode ser o root. Na nuvem, crie um usuário só para o sistema,
# com permissão apenas no banco jb_ferramentas.
MYSQL_USER=root
MYSQL_PASSWORD=sua_senha_aqui
MYSQL_DB=jb_ferramentas

# Chave usada pelo Flask para proteger a sessão de login.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
